# PostgreSQL 18 (copia este archivo a .env antes de levantar Docker)
POSTGRES_DB=andesshield
POSTGRES_USER=andesshield
POSTGRES_PASSWORD=CAMBIA_ESTA_CLAVE_SEGURA_DE_BD

# Backend Rust (Axum)
APP_PORT=8080
RUST_LOG=andesshield_api=info,tower_http=info
COOKIE_SECURE=false
SESSION_TTL_HOURS=24

# Opcional: si deseas pre-crear un administrador inicial al arrancar con BD vacía
# (Si se omiten, puedes registrar tu primera cuenta directamente desde la interfaz web)
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
